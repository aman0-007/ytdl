{
  "manifest_version": 3,
  "name": "RAW SNATCHER",
  "version": "1.0",
  "description": "No bloat. No ads. Just the file.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.css", "popup.js"],
      "matches": ["*://*.youtube.com/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "raw-snatcher@yourdomain.com",
      "strict_min_version": "109.0"
    }
  }
}